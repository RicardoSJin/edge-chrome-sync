{
  "manifest_version": 3,
  "name": "桥同步 · Edge & Chrome",
  "version": "1.0.3",
  "minimum_chrome_version": "120",
  "description": "通过自己的 WebDAV 同步收藏夹、隐私偏好和字号，使用独立口令端到端加密。",
  "permissions": ["storage", "bookmarks", "alarms"],
  "optional_permissions": ["privacy", "fontSettings"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "action": {"default_title": "打开桥同步", "default_icon":{"16":"icons/16.png","32":"icons/32.png"}},
  "options_page": "options.html",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
